DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk
INIT_DB=1

# Leave empty for keyless mode: the provider is still called, a static draft is used.
# Any OpenAI-compatible API works. Tested with Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_RATE_LIMIT_PER_MINUTE=60

WORKER_CONCURRENCY=20
DELIVERY_CONCURRENCY=4

# Share of mock helpdesk replies that fail with 503 / answer after the client timeout.
MOCK_FAILURE_RATE=0.2
MOCK_SLOW_RATE=0.1

# Integration tests (a separate database; tables are dropped).
TEST_DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk_test

# Base URL for Help Center links in drafts (Vercel sets it automatically).
PUBLIC_BASE_URL=http://localhost:8000
